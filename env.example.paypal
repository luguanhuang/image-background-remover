# Existing app config
REMOVE_BG_API_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Public/base URL used to build PayPal return/cancel URLs
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayPal config
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# One-time credit pack prices (server allowlist)
PAYPAL_CREDIT_PACK_10_PRICE=4.99
PAYPAL_CREDIT_PACK_50_PRICE=14.99
PAYPAL_CREDIT_PACK_200_PRICE=39.99

# Optional monthly subscription plan IDs (P-...)
PAYPAL_PLAN_STARTER_ID=
PAYPAL_PLAN_PRO_ID=

# Optional webhook id for later verification wiring
PAYPAL_WEBHOOK_ID=
